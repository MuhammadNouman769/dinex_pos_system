# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time (restart `npm run dev` after changing).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- SEO / Google (only matter in production; deploy/setup.sh fills them for Docker) ----
# Public address of the site: used for canonical links, sitemap.xml, robots.txt and share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the landing-page footer and in structured data. Leave empty to hide.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Search Console -> "HTML tag" verification: paste ONLY the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_WHATSAPP=923248699647
