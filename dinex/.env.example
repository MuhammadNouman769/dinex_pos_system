# Copy to .env (scripts/dev-setup.sh does this for you). NEVER commit .env
# ---- Local development ----
SECRET_KEY=dev-only-key-for-local-testing-never-use-in-production-0123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# API docs (Swagger) at http://localhost:8000/api/docs/ . On by default when DEBUG=True.
# ENABLE_API_DOCS=True

# ---- Email (loyalty codes / reminders). Default prints emails in the terminal. ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=DineX <you@gmail.com>

# ---- Production uses PostgreSQL. In Docker, deploy/setup.sh generates all of this for you. ----
# DEBUG=False
# DATABASE_URL=postgresql://dinex:PASSWORD@db:5432/dinex
# CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
# LOGIN_RATE=30/min
